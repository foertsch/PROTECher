# Cluster names and paths for the slurm/*.sh scripts. No script contains them.
#
# Copy this file to ~/.config/protecher/cluster.env twice and fill it in: once on the laptop (submit_with_report.sh reads it
# there) and once on the cluster (the job scripts and preflight.sh read it there; the home directory is shared by the login
# and the compute nodes). It holds no secrets, only names. Set PROTECHER_CONFIG to read another file.
#
# CLUSTER_SSH is best an alias in ~/.ssh/config on the laptop, so no host name appears in any command:
#   Host login
#       HostName <login node>
#       User <user>

# Node-local scratch of the GPU node, where the install, the weights and the caches live. It differs from the login node's.
export PROTECHER_SCRATCH=/scratch/<user>
# The GPU node that holds the install, and its Slurm partition. Jobs are pinned to it with -w.
export PROTECHER_GPU_NODE=<node>
export PROTECHER_GPU_PARTITION=<partition>
# Optional second GPU node, only for the free-GPU line of slurm/preflight.sh. Its scratch is a different disk.
export PROTECHER_SECOND_GPU_NODE=
# Laptop only: how to reach the login node. An ssh alias such as login, or user@host.
export CLUSTER_SSH=login
